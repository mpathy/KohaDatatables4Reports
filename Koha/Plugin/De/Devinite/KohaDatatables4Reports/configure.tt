[% USE raw %]
[% PROCESS 'i18n.inc' %]
[% SET footerjs = 1 %]
[% INCLUDE 'doc-head-open.inc' %]
<title>DataTables for Reports - Configuration</title>
[% INCLUDE 'doc-head-close.inc' %]
</head>
<body id="plugin_datatables_configure" class="plugins">
[% WRAPPER 'header.inc' %]
[% END %]

[% WRAPPER 'sub-header.inc' %]
    [% WRAPPER breadcrumbs %]
        [% WRAPPER breadcrumb_item %]
            <a href="/cgi-bin/koha/plugins/plugins-home.pl">Plugins</a>
        [% END %]
        [% WRAPPER breadcrumb_item bc_active= 1 %]
            DataTables for Reports
        [% END %]
    [% END %]
[% END %]

<div class="main container-fluid">
    <div class="row">
        <div class="col-md-8 col-md-offset-2">

            <div class="panel panel-default" style="margin-top: 30px;">
                <div class="panel-heading">
                    <h2><i class="fa fa-table"></i> DataTables for Reports</h2>
                </div>
                <div class="panel-body">
                    <p>This plugin adds an interactive <strong>"Open in DataTables"</strong> button to your Koha report results.
                       It fetches all report data and replaces the standard paginated table with a full-featured DataTables view.</p>

                    <h4>How to use:</h4>
                    <ol>
                        <li>Go to <a href="/cgi-bin/koha/reports/guided_reports.pl">Reports</a> and run any saved report</li>
                        <li>Click the green <strong>"Open in DataTables"</strong> button in the toolbar</li>
                        <li>Click <strong>"Back to original view"</strong> to return to the standard table</li>
                    </ol>

                    <h4>Features:</h4>
                    <ul>
                        <li>Fast sorting by any column (click header)</li>
                        <li>Full-text search across all columns</li>
                        <li>Adjustable page size (10 / 25 / 50 / 100 / 250 / 500 / All)</li>
                        <li>Column visibility toggle (show/hide columns)</li>
                        <li>Column resize (drag right edge of header)</li>
                        <li>Fixed header (stays visible while scrolling)</li>
                        <li>Export filtered data as CSV, Excel (XLSX) or PDF</li>
                        <li>Copy filtered to clipboard or print directly in the browser</li>
                    </ul>
                </div>
            </div>

            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title"><i class="fa fa-cog"></i> Configuration</h3>
                </div>
                <div class="panel-body">
                    <p class="text-muted">There are no user-configurable settings at the moment.<br>
                    Future versions may allow customization of certain datatable settings.<br>
                    This feature will be included when Koha adds an up-to-date version of DataTables.</p>
                </div>
            </div>

        </div>
    </div>
</div>

[% MACRO jsinclude BLOCK %]
[% END %]

[% INCLUDE 'intranet-bottom.inc' %]
